# Camera 03 (Packaging Area)
CAMERA_03_RTSP_URL=rtsp://admin:secret_password@192.168.1.103:554/h264Preview_01_main

# Camera 04 (Warehouse Storage)
CAMERA_04_RTSP_URL=rtsp://admin:secret_password@192.168.1.104:554/h264Preview_01_main

